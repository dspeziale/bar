# ── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=cambia-con-una-stringa-casuale-lunga-almeno-32-caratteri

# ── Database ─────────────────────────────────────────────────────────────────
# Sviluppo locale: SQLite (default se non impostato)
DATABASE_URL=sqlite:///bar.db

# Produzione: Neon PostgreSQL (copia da Neon Dashboard → Connection String)
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Solo sviluppo locale: abilita OAuth su HTTP (non impostare in produzione) ─
AUTHLIB_INSECURE_TRANSPORT=1

# ── Telegram (configurabili anche dal backoffice /admin/settings) ─────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Gmail ─────────────────────────────────────────────────────────────────────
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
